# Copy this file to .env for local development.
# Never commit real secrets. Provider adapters can be added later without changing ERP routes.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anvi_mitra_erp
JWT_SECRET=replace-with-at-least-32-characters
CORS_ORIGIN=http://localhost:4000

# Payment gateway seam
PAYMENT_PROVIDER=manual_adapter
PAYMENT_WEBHOOK_SECRET=

# Push/Firebase seam
PUSH_PROVIDER=placeholder
PUSH_PROVIDER_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# SMS seam
SMS_PROVIDER=placeholder
SMS_API_KEY=

# Email seam
EMAIL_PROVIDER=placeholder
EMAIL_API_KEY=

# Local PC/NAS storage seam
STORAGE_PROVIDER=local_connector
